# Connexion à la base de données Neon (Postgres). NE JAMAIS la mettre dans le code ni sur GitHub.
DATABASE_URL=postgresql://utilisateur:motdepasse@hote.neon.tech/neondb?sslmode=require

# Chaîne aléatoire longue (>= 32 caractères). Sert à anonymiser les adresses IP (hachage).
SESSION_SECRET=remplacez-par-une-longue-chaine-aleatoire

# Jeton à usage unique pour créer le premier compte administrateur sur /admin/setup.
# Après la création du compte, la page /admin/setup se désactive d'elle-même.
ADMIN_SETUP_TOKEN=remplacez-par-un-jeton-secret

# URL publique du site (sans slash final), utilisée pour le SEO et le sitemap.
NEXT_PUBLIC_SITE_URL=https://votre-domaine.com
